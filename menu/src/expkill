#!/bin/bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  expkill — enforce SSH account expiry.
#
#  For every expired SSH account: lock it, kill its live sessions,
#  then delete it. Deleting before killing (what the old code did)
#  leaves the running session untouched, which is why expired users
#  stayed online.
#
#  SSH only — this script does not touch xray/config.json.
#  It is cheap (one read of /etc/shadow), so cron runs it every
#  minute instead of once a day.
#
#  usage: expkill [--quiet]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1

say() { [ "$QUIET" -eq 1 ] || echo -e "$*"; }

LOGFILE="/root/log-expired.txt"
NOW="$(date +%s)"
TODAY="$(date +%d-%m-%Y)"

KICK="$(command -v kickuser || echo /usr/local/sbin/kickuser)"

# Field 8 of /etc/shadow is the account expiry, in days since 1970-01-01.
# An empty field means "never expires" — skip those.
while IFS=: read -r username expdays; do
	[ -z "$username" ] && continue
	[ -z "$expdays" ] && continue
	case "$expdays" in
		*[!0-9]*) continue ;;
	esac

	# Only real customer accounts. Never system accounts, never root.
	uid="$(id -u "$username" 2>/dev/null)" || continue
	[ -z "$uid" ] && continue
	[ "$uid" -lt 1000 ] && continue

	# Same comparison the original script used: not expired while the
	# expiry day is still ahead of now.
	if [ "$((expdays * 86400))" -ge "$NOW" ]; then
		continue
	fi

	say "expkill: '$username' expired — locking, disconnecting, removing"
	echo "$TODAY $(date +%X) - expired - $username - kicked and removed" >>"$LOGFILE"

	# --lock closes the door, the kill empties the room, --delete
	# removes the account only once nothing of it is running.
	"$KICK" "$username" --lock --delete --quiet
done < <(cut -d: -f1,8 /etc/shadow)

exit 0
